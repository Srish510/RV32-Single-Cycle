[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 4
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 6

[engines]
smtbmc z3

[script]
read_verilog -I include core/alu.v
read_verilog -I include core/alu_mux.v
read_verilog -I include core/branch_unit.v
read_verilog -I include core/immediate_gen.v
read_verilog -I include core/lsu.v
read_verilog -I include core/main_decoder.v
read_verilog -I include core/pc_controller.v
read_verilog -I include core/pc_src_mux.v
read_verilog -I include core/pc_writeback_mux.v
read_verilog -I include core/program_counter.v
read_verilog -I include core/register_file.v
read_verilog -I include core/write_back_mux.v
read_verilog -I include core/rv32i_core.v
expose rv32i_core/next_pc rv32i_core/reg_write rv32i_core/write_data rv32i_core/read_data1 rv32i_core/read_data2
read_verilog -I include core/rv32i_rvfi_wrapper.v
read_verilog -formal -I include core/formal_rvfi_core.v
prep -top formal_rvfi_core

[files]
include/rv32i_defs.vh src/include/rv32i_defs.vh
core/alu.v src/core/alu.v
core/alu_mux.v src/core/alu_mux.v
core/branch_unit.v src/core/branch_unit.v
core/immediate_gen.v src/core/immediate_gen.v
core/lsu.v src/core/lsu.v
core/main_decoder.v src/core/main_decoder.v
core/pc_controller.v src/core/pc_controller.v
core/pc_src_mux.v src/core/pc_src_mux.v
core/pc_writeback_mux.v src/core/pc_writeback_mux.v
core/program_counter.v src/core/program_counter.v
core/register_file.v src/core/register_file.v
core/write_back_mux.v src/core/write_back_mux.v
core/rv32i_core.v src/core/rv32i_core.v
core/rv32i_rvfi_wrapper.v formal/rvfi/rv32i_rvfi_wrapper.v
core/formal_rvfi_core.v formal/properties/formal_rvfi_core.v
