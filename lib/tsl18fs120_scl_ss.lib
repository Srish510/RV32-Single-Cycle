    test_cell() { 
      /* single output */

      pin(D,E) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      latch(IQ,IQN) { 
        data_in : "D" ; 
        /* "normal" behaviour */
        enable : "E" ; 
      }

      pin(Q) { 
        direction : output ; 
        function : "IQ" ; 
      }

      pin(SO) { 
        direction : output ; 
        signal_type : "test_scan_out" ; 
      }
    }
  }

