    test_cell() { 
      /* both outputs */

      pin(D,E) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(CDN) { 
        direction : input ; 
      }

      pin(SDN) { 
        direction : input ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      latch(IQ,IQN) { 
        data_in : "D" ; 
        /* "normal" behaviour */
        enable : "E" ; 
        clear : "CDN'" ; 
        preset : "SDN'" ; 
        clear_preset_var2 : "H" ; 
        clear_preset_var1 : "H" ; 
      }

      pin(Q) { 
        direction : output ; 
        function : "IQ" ; 
      }

      pin(SO) { 
        direction : output ; 
        signal_type : "test_scan_out" ; 
      }

      pin(QN) { 
        direction : output ; 
        function : "IQN" ; 
      }
    }
  }

