    test_cell() { 
      /* both outputs */

      pin(D,CP) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(CDN) { 
        direction : input ; 
      }

      pin(SDN) { 
        direction : input ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      ff(IQ,IQN) { 
        next_state : "D" ; 
        /* "normal" behaviour */
        clocked_on : "CP" ; 
        clear : "CDN'" ; 
        preset : "SDN'" ; 
        clear_preset_var2 : "L" ; 
        clear_preset_var1 : "L" ; 
      }

      pin(Q) { 
        direction : output ; 
        function : "IQ" ; 
        signal_type : "test_scan_out" ; 
      }

      pin(QN) { 
        direction : output ; 
        function : "IQN" ; 
        signal_type : "test_scan_out_inverted" ; 
      }
    }
