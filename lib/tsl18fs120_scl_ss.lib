      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      ff(IQ,IQN) { 
        next_state : "D" ; 
        /* "normal" behaviour */
        clocked_on : "CP" ; 
        preset : "SDN'" ; 
      }

      pin(Q) { 
