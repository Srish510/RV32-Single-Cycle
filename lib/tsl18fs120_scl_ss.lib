    test_cell() { 
      /* both outputs */

      pin(D,E) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(OE) { 
        direction : input ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      latch(IQ,IQN) { 
        data_in : "D" ; 
        /* "normal" behaviour */
        enable : "E" ; 
      }

      pin(Z) { 
        direction : output ; 
        function : "IQ" ; 
        three_state : "(OE)'" ; 
      }

      pin(SO) { 
        direction : output ; 
        signal_type : "test_scan_out" ; 
      }
    }
  }

