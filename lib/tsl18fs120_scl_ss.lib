    test_cell() { 
      /* single output */

      pin(D,CP) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      ff(IQ,IQN) { 
        next_state : "D" ; 
        /* "normal" behaviour */
        clocked_on : "CP" ; 
      }

      pin(QN) { 
        direction : output ; 
        function : "IQN" ; 
        signal_type : "test_scan_out_inverted" ; 
      }
    }
  }

