      latch(IQ,IQN) { 
        data_in : "D" ; 
        /* "normal" behaviour */
        enable : "E" ; 
      }

      pin(Q) { 
        direction : output ; 
        function : "IQ" ; 
      }

      pin(SO) { 
        direction : output ; 
        signal_type : "test_scan_out" ; 
      }
    }
