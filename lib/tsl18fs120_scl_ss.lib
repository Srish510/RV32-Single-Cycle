    test_cell() { 
      /* single output */

      pin(D,CP) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(CDN) { 
        direction : input ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      ff(IQ,IQN) { 
        next_state : "D" ; 
        /* "normal" behaviour */
        clocked_on : "CP" ; 
        clear : "CDN'" ; 
      }

      pin(Q) { 
        direction : output ; 
        function : "IQ" ; 
        signal_type : "test_scan_out" ; 
      }
    }
  }

