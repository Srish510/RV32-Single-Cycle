      pin(D,CPN) { 
        direction : input ; 
      }

      pin(SD) { 
        direction : input ; 
        signal_type : "test_scan_in" ; 
      }

      pin(CDN) { 
        direction : input ; 
      }

      pin(SC) { 
        direction : input ; 
        signal_type : "test_scan_enable" ; 
      }

      ff(IQ,IQN) { 
        next_state : "D" ; 
        /* "normal" behaviour */
        clocked_on : "CPN'" ; 
        clear : "CDN'" ; 
      }

      pin(Q) { 
        direction : output ; 
        function : "IQ" ; 
        signal_type : "test_scan_out" ; 
      }

      pin(QN) { 
        direction : output ; 
        function : "IQN" ; 
        signal_type : "test_scan_out_inverted" ; 
      }
    }
  }

